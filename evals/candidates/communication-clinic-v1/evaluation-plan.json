{
  "schema_version": "1.0",
  "candidate_id": "communication-clinic-v1",
  "content_status": "candidate",
  "run_status": "not_run",
  "review_status": "evaluation_plan_only",
  "canonical_lab": false,
  "formal_task_set_entry": false,
  "task": {
    "input_path": "workspace/evidence-packet.md",
    "contract_path": "task-contract.md",
    "acceptance_path": "acceptance.json",
    "output_path": "output/release-handoff.md",
    "risk": "low",
    "synthetic": true
  },
  "conditions": [
    {
      "id": "A",
      "prompt_path": "prompts/a-vague.txt",
      "contract_channel": "none_initially",
      "contract_content_path": null
    },
    {
      "id": "B",
      "prompt_path": "prompts/b-structured.txt",
      "contract_channel": "user_request_template",
      "contract_content_path": "task-contract.md"
    },
    {
      "id": "C",
      "prompt_path": "prompts/c-shared-context-short.txt",
      "contract_channel": "recorded_shared_context",
      "contract_content_path": "task-contract.md"
    }
  ],
  "controls": {
    "fresh_session_per_run": true,
    "fresh_disposable_workspace_per_run": true,
    "same_model_version_settings_tools_permissions_and_budget": true,
    "condition_order": "randomized_per_repetition_with_recorded_seed",
    "minimum_repetitions_per_available_condition": 5,
    "maximum_user_repair_turns": 2,
    "condition_blind_reviewers": 2,
    "preserve_all_repetitions": true
