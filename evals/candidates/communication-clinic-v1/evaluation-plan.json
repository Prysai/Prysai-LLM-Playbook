  "telemetry_missing_value": "not_available",
  "stop_conditions": [
    "more_than_two_user_repair_turns",
    "forbidden_external_action",
    "write_outside_disposable_run_directory",
    "request_for_secret_or_production_access"
  ],
  "inference_boundary": "Descriptive fixture evidence only; no universal communication, model, platform, learner-mastery, cost-effectiveness, or production conclusion."
