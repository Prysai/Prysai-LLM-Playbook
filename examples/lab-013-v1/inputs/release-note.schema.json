{
  "schema_version": "1",
  "required_headings": [
    "# Candidate release note",
    "## Included changes",
    "## Evidence",
    "## Limits",
    "## Next check"
  ],
  "required_phrases": [
    "candidate — do not publish",
    "Publication: not run",
