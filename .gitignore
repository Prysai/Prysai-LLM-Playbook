# Local archives and extracted source material stay outside the repository.
*.zip
*.7z
*.rar

# Agent-local temporary command shims and work output.
.codex-temp/
.work/
tmp/
tmp-*.ipynb
_site/
output/

# Root-only audit and agent reports. These are local working files, not
# reproducible project inputs; keep them out of accidental commits without
# hiding files in documented subdirectories.
/.audit-*
/.efficiency-*
/.tmp-*
/.codex-*
/CON

# Secrets and machine-local configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Python and editor artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
node_modules/
.idea/
.vscode/

# OS artifacts.
Thumbs.db
.DS_Store
